
## update the system packages
sudo apt-get update

## #1: Install OpenJDK 21 on Ubuntu 24.04 LTS
apt install openjdk-21-jdk openjdk-21-jre -y

##Download the SonaType Nexus on Ubuntu using wget
cd /opt 
sudo wget https://download.sonatype.com/nexus/3/nexus-3.84.1-01-linux-x86_64.tar.gz
 


##Extract the Nexus repository setup in /opt directory
tar -xvzf nexus-3.84.1-01-linux-x86_64.tar.gz    

##Rename the extracted Nexus setup folder to nexus
sudo mv /opt/nexus-3.84.1-01/ /opt/nexus

##As security practice, not to run nexus service using root user, so lets create new user named nexus to run nexus service
sudo adduser nexus   --> give password


##To set no password for nexus user open the visudo file in ubuntu
sudo visudo

##Add below line into itbelow defaults use_pty line , save and exit i.e., press ctrl+X, press y and press enter
nexus ALL=(ALL) NOPASSWD: ALL

##Give permission to nexus files and nexus directory to nexus user
sudo chown -R nexus:nexus /opt/nexus
sudo chown -R nexus:nexus /opt/sonatype-work        

##To run nexus as service at boot time, open /opt/nexus/bin/nexus.rc file and add nexus user as shown below
sudo vi /opt/nexus/bin/nexus.rc
run_as_user="nexus"   


##To Increase the nexus JVM heap size, you can modify the size as shown below

vi /opt/nexus/bin/nexus.vmoptions
-Xms512m
-Xmx512m
-XX:MaxDirectMemorySize=512m

-XX:+UnlockDiagnosticVMOptions
-XX:LogFile=/opt/sonatype-work/nexus3/log/jvm.log
-XX:-OmitStackTraceInFastThrow

-Djava.net.preferIPv4Stack=true
-Dkaraf.home=.
-Dkaraf.base=.
